{
  "name": "neural-network-playground",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "An interactive neural network playground for learning \u2014 inspired by TensorFlow Playground",
  "scripts": {
    "dev": "pnpm --filter @nn-playground/web dev",
    "build": "pnpm --filter @nn-playground/web build",
    "build:e2e": "VITE_E2E_FAULTS=1 pnpm build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r test",
    "test:e2e": "playwright test",
    "test:e2e:recovery": "pnpm run build:e2e && playwright test tests/e2e/worker-recovery.spec.ts --project=chromium --project=webkit --grep \"@fault-enabled\"",
    "test:engine": "pnpm --filter @nn-playground/engine test",
    "test:perf": "node scripts/run-performance-gates.mjs",
    "test:bundle": "node scripts/check-web-bundle-gzip.mjs",
    "bench": "pnpm --filter @nn-playground/engine bench",
    "lint": "eslint .",
    "clean": "pnpm -r exec rm -rf dist node_modules"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/js": "^9.0.0",
    "@playwright/test": "^1.61.1",
    "eslint": "^9.0.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "typescript-eslint": "^8.0.0"
  },
  "pnpm": {
    "overrides": {
      "undici@>=7 <7.29.0": "^7.29.0",
      "brace-expansion@>=1 <1.1.18": "^1.1.18",
      "brace-expansion@>=5 <5.0.9": "^5.0.9",
      "js-yaml@>=4 <4.3.2": "^4.3.2",
      "browserslist@<4.28.7": "^4.28.7",
      "@babel/core@>=7 <7.29.6": "^7.29.6",
      "baseline-browser-mapping@<2.11.0": "^2.11.0"
    }
  }
}
